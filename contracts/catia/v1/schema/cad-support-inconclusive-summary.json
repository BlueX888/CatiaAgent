  "additionalProperties": false,
  "properties": {
    "attemptCount": {
      "maximum": 10,
      "minimum": 1,
      "title": "Attemptcount",
      "type": "integer"
    },
    "candidateCount": {
      "minimum": 0,
      "title": "Candidatecount",
      "type": "integer"
    },
    "consistencyBudgetMm3": {
      "exclusiveMinimum": 0,
      "title": "Consistencybudgetmm3",
      "type": "number"
    },
    "reason": {
      "enum": [
        "COMMON_UNION_DISAGREES",
        "INSUFFICIENT_CONSISTENT_BOOLEANS",
        "FUZZY_LEVELS_DISAGREE"
