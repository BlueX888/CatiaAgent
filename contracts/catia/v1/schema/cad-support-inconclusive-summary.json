      "title": "Reason",
      "type": "string"
    },
    "volumeDiagnostics": {
      "anyOf": [
        {
          "$ref": "#/$defs/VolumeDiagnostics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "reason",
    "consistencyBudgetMm3",
    "attemptCount",
    "candidateCount"
